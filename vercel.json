{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://crm5-backend.italynorth.cloudapp.azure.com/api/:path*"
    },
    {
      "source": "/client",
      "destination": "/index.html"
    },
    {
      "source": "/client/:path*",
      "destination": "/index.html"
    }
  ]
}
